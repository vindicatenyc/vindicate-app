# Supabase Self-Hosted Configuration
# Copy this to .env and fill in real values

# Postgres
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT — minimum 32 characters
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
ANON_KEY=your-anon-jwt-token
SERVICE_ROLE_KEY=your-service-role-jwt-token

# API
SITE_URL=http://localhost:3456
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# Auth (GoTrue)
GOTRUE_EXTERNAL_URL=http://localhost:8000/auth/v1
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMS_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_SITE_URL=http://localhost:3456
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# Studio
STUDIO_DEFAULT_ORGANIZATION=Vindicate NYC
STUDIO_DEFAULT_PROJECT=Vindicate
STUDIO_PORT=8082
SUPABASE_STUDIO_PORT=8082

# Kong
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Dashboard credentials (for Studio login)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your-dashboard-password
